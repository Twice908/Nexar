{
  "name": "nexar",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --profile infra up -d",
    "infra:down": "docker compose --profile infra down",
    "infra:logs": "docker compose --profile infra logs -f",
    "db:migrate": "pnpm --filter @nexar/db db:migrate",
    "db:seed": "pnpm --filter @nexar/db db:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}